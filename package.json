{
  "name": "performance-tests",
  "version": "0.2.0",
  "description": "Test performance of parsing, processing and serialization of 3D models",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "mocha",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pug": "^3.0.3",
    "readdirp": "^4.0.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.0",
    "@types/pug": "^2.0.10",
    "mocha": "^10.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickify/performance-tests.git"
  },
  "keywords": [
    "test",
    "performance"
  ],
  "author": "Adrian Sieber",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brickify/performance-tests/issues"
  },
  "homepage": "https://github.com/brickify/performance-tests#readme"
}
